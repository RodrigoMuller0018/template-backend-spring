<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Beans do Spring recebem dependências imutáveis por construtor; expor/armazenar referência é esperado. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- Construtores de beans Spring podem lançar exceção durante a injeção; não é um risco real aqui. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
</FindBugsFilter>
